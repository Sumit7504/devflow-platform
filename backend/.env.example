# ==============================================================================
# DevFlow Backend Environment Variables Example
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file with secrets into version control.
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local development: mongodb://localhost:27017/devflow
# For production (MongoDB Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/devflow?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/devflow

# JSON Web Token (JWT) Configuration
# In production, JWT_SECRET must be at least 32 random characters and cannot use placeholders.
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS & Socket.IO)
# Comma-separated list of allowed origins. Spaces and trailing slashes are trimmed automatically.
# Example for production: https://devflow-client.vercel.app,https://admin.devflow.com
CLIENT_URL=http://localhost:5173

# Rate Limiting Configuration (Optional)
# RATE_LIMIT_MAX_GENERAL: Max requests per 15 minutes across /api (default: 600)
# RATE_LIMIT_MAX_AUTH: Max requests per 15 minutes for login and register (default: 10)
# DISABLE_RATE_LIMIT: Set to true to disable rate limiting in test/development environments (default: false)
RATE_LIMIT_MAX_GENERAL=600
RATE_LIMIT_MAX_AUTH=10
DISABLE_RATE_LIMIT=false

# Initial Admin Seeding (run: npm run seed:admin)
# In production, ADMIN_PASSWORD must be at least 12 characters and cannot be trivial.
ADMIN_EMAIL=admin@devflow.com
ADMIN_PASSWORD=replace_with_a_strong_password

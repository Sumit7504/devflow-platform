# ==============================================================================
# DevFlow Frontend Environment Variables
# Copy this file to .env and configure the appropriate API and Socket addresses.
# ==============================================================================

# REST API base URL
# In development: http://localhost:5000/api
# In production: https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket server root URL
# In development: http://localhost:5000
# In production: https://your-backend-service.onrender.com
VITE_SOCKET_URL=http://localhost:5000
